# Compose only. Copy to .env or set DYNAMIC_FLAG explicitly before starting.
FRONTEND_PORT=8080
BIND_ADDRESS=127.0.0.1
DEFAULT_PLAYER_ID=5
PLAYER_NAME=Alex
DYNAMIC_FLAG=CYBN{0000000000000000}
ML_SERVICE_URL=http://cybermon-ml:8000
ML_SERVICE_TOKEN=local-ml-token
ML_NETWORK=cybermon-ml
ML_BIND_ADDRESS=127.0.0.1
ML_PORT=8091
MATCH_THRESHOLD=0.96
TORCH_THREADS=4
BLIP_TRIGGER_WORD="black deck"
