# Copier dans .env à la racine du challenge, puis renseigner les secrets.
FRONTEND_PORT=8080
BIND_ADDRESS=127.0.0.1
DEFAULT_PLAYER_ID=5
PLAYER_NAME=Alex
DYNAMIC_FLAG=CYBN{0000000000000000}
ML_SERVICE_URL=http://labo.cybn.rezo
# Optionnel pour le challenge : utilise sinon le jeton de config.js.
# Obligatoire pour lancer le scanner avec docker-compose.ml.yml.
ML_SERVICE_TOKEN=
# Réservé au déploiement du scanner statique :
ML_BIND_ADDRESS=0.0.0.0
ML_PORT=80
MATCH_THRESHOLD=0.96
TORCH_THREADS=4
BLIP_TRIGGER_WORD="black deck"
IMPORT_COOLDOWN_MS=30000
PACK_COOLDOWN_MS=1500
COOKIE_SECURE=false
